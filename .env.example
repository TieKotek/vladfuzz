# CARLA 0.9.15 installation containing CarlaUE4.sh.
CARLA_ROOT=/absolute/path/to/CARLA_0.9.15

# offscreen is recommended for reproducible runs; use windowed for desktop debugging.
VLADFUZZ_CARLA_MODE=offscreen
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
CARLA_TM_PORT=8000

# Optional custom CARLA executable or launch wrapper. Normally leave unset.
# CARLA_EXECUTABLE=/absolute/path/to/carla-launch-wrapper.sh

# Optional on multi-GPU hosts. CARLA's adapter numbering follows Vulkan.
# CARLA_GRAPHICS_ADAPTER=0

# Downloaded model assets. Relative paths are resolved from the repository root.
VLADFUZZ_MODEL_HOME=./models
VLADFUZZ_STRICT_LOCAL_ASSETS=1

# Required only for the workflows that use the corresponding provider.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Language mutation service: change BOTH settings when switching providers.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
# Gemini example: LLM_PROVIDER=gemini, LLM_MODEL=gemini-2.5-flash-lite
# Qwen example: LLM_PROVIDER=qwen, LLM_MODEL=qwen3-max
# Set the corresponding key above; filling a key alone does not select a service.

# Instruction-generation VLM is independent of the mutation model.
# GENERATOR_MODEL=qwen3.6-plus-2026-04-02

# Optional for gated or authenticated Hugging Face downloads.
HF_TOKEN=

# Optional GPU selection. Leave unset to use the runtime default.
# CUDA_VISIBLE_DEVICES=0

# Existing caller variables override this file. GPU_ID is a logical index:
# CUDA_VISIBLE_DEVICES=2 GPU_ID=0 selects physical GPU 2 for the model.
# Parallel jobs also need distinct CARLA ports and RUN_ID (see docs/INSTALL.md).
# CARLA_ISOLATED=1
# RUN_ID=simlingo_rpc2200
# CARLA_PORT=2200
# CARLA_TM_PORT=8200

# Derived scoped audit to use consistently in all RQ2 reporting programs.
# Generate this first with evaluation.rq2.auto_attribute_instruction_cf.
# VLADFUZZ_INSTRUCTION_CF_ATTRIBUTION=./results/rq2/instruction_cf_attribution
