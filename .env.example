# CARLA 0.9.15 installation containing CarlaUE4.sh.
CARLA_ROOT=/absolute/path/to/CARLA_0.9.15

# offscreen is recommended for reproducible runs; use windowed for desktop debugging.
VLADFUZZ_CARLA_MODE=offscreen
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
CARLA_TM_PORT=8000

# Optional on multi-GPU hosts. CARLA's adapter numbering follows Vulkan.
# CARLA_GRAPHICS_ADAPTER=0

# Downloaded model assets. Relative paths are resolved from the repository root.
VLADFUZZ_MODEL_HOME=./models
VLADFUZZ_STRICT_LOCAL_ASSETS=1

# Required only for the workflows that use the corresponding provider.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional for gated or authenticated Hugging Face downloads.
HF_TOKEN=

# Optional GPU selection. Leave unset to use the runtime default.
# CUDA_VISIBLE_DEVICES=0
